{
  "name": "ai-resume-analyzer",
  "private": true,
  "version": "1.0.0",
  "description": "AI-powered resume analyzer. Vite/React frontend + Express API, deployed as a single Vercel project.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22"
  },
