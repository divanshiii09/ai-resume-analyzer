# MongoDB Atlas connection string.
# Atlas > Network Access must allow 0.0.0.0/0 for Vercel's rotating egress IPs.
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/resume-analyzer

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Signing secret for auth tokens. Generate with: openssl rand -base64 32
JWT_SECRET=

# Local dev only. Vercel assigns the port itself.
PORT=3000

# Optional. Gemini request timeout in ms; keep below vercel.json maxDuration.
GEMINI_TIMEOUT_MS=45000
